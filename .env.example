PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=light_assistant
FRONTEND_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
SESSION_SECRET=replace_with_a_long_random_string

# Optional: 32+ char random string used to encrypt integration credentials
# (falls back to a key derived from SESSION_SECRET if empty)
ENCRYPTION_KEY=

# Optional AI providers (leave AI_PROVIDER=rules for rule-based only)
AI_PROVIDER=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
CLOUD_AI_URL=
CLOUD_AI_KEY=
CLOUD_AI_MODEL=
